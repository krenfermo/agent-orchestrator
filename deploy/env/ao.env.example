# AO staging environment file.
# Copy to /etc/agent-orchestrator/ao.env, then: chmod 640 + chown root:ao.
# Referenced by deploy/systemd/agent-orchestrator.service via EnvironmentFile=.
# Do not commit a filled-in copy of this file; it is a template only.

# --- Filesystem layout (see docs/deployment/hetzner-staging.md) ---
AO_DATA_DIR=/var/lib/agent-orchestrator/data
AO_RUN_FILE=/var/lib/agent-orchestrator/data/running.json
AO_PROJECT_ROOTS=/var/lib/agent-orchestrator/repos

# Isolated tmux server name so the AO service never touches an operator's
# personal tmux server. `tmux -L ao-staging`.
AO_TMUX_SOCKET=ao-staging

# --- Network ---
# AO_PORT is read by backend/internal/config; the systemd unit also passes
# --port explicitly for anyone reading the unit file in isolation. AO always
# binds 127.0.0.1 (config.LoopbackHost) — this is a hard rule, not tunable
# here. Remote access comes only through the reverse proxy (deploy/caddy).
AO_PORT=3001

# --- PATH ---
# systemd services do not inherit a login shell PATH. List every directory
# that holds git, tmux, codex, claude, gh, and the ao binary itself. Adjust
# to match `which codex`, `which claude`, `which gh` on the actual host —
# see docs/deployment/hetzner-staging.md section 7.
PATH=/opt/agent-orchestrator/bin:/usr/local/bin:/usr/bin:/bin:/home/ao/.local/bin

# HOME must be set explicitly: systemd's default DynamicUser/User= services
# do not source /etc/passwd for $HOME the way an interactive login shell
# does in every code path, and codex/claude/gh all resolve their own config
# under $HOME (~/.codex, ~/.claude, ~/.config/gh).
HOME=/home/ao

# --- Telemetry (optional, default off for staging) ---
# AO_TELEMETRY_DISABLED_EVENTS=*
